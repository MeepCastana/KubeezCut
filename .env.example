# ===========================================
# Frontend Configuration (Vite)
# ===========================================

# Public site URL (no trailing slash). Used for canonical, Open Graph, Twitter cards,
# JSON-LD, robots.txt, and sitemap.xml. Set to your production domain in CI (e.g. Vercel).
# VITE_PUBLIC_SITE_URL=https://editor.kubeez.com

# Browser calls Kubeez API at this origin (skips same-origin /api/kubeez). Requires CORS on api.kubeez.com.
# When set, media downloads also use https://media.kubeez.com directly — configure that host with
# Access-Control-Allow-Origin (and Cross-Origin-Resource-Policy: cross-origin if the editor uses COEP).
# Unset in dev (Vite proxy). Production + editor.kubeez.com infers https://api.kubeez.com when unset.
# Use empty value only if you must force proxy-only: VITE_KUBEEZ_BROWSER_API_URL=
# VITE_KUBEEZ_BROWSER_API_URL=https://api.kubeez.com
#
# Self-hosted without direct media CORS: reverse-proxy /api/kubeez/cdn/* → media and /api/kubeez/* → api;
# leave VITE_KUBEEZ_BROWSER_API_URL unset so the client uses same-origin /api/kubeez. Legacy /api/kubeez-media/* supported.

# Show/hide floating debug button in editor (dev mode only)
# Set to 'false' to hide debug panel button during development
VITE_SHOW_DEBUG_PANEL=true

# ===========================================
# Kubeez Account (Supabase) — required for "Sign in with Kubeez"
# ===========================================
# Same Supabase project as kubeez.com. Find these in kubeez-website/.env.
# Without them, useKubeezSession sees `isConfigured=false` and the editor
# can't read the `.kubeez.com` cookie set by kubeez.com prod auth.
# VITE_SUPABASE_URL=https://connect.kubeez.com
# VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# ===========================================
# Cloudflare tunnel dev host (optional)
# ===========================================
# When running the editor through a Cloudflare tunnel
# (e.g. https://dev-editor.kubeez.com → http://localhost:5173) for
# end-to-end SSO testing with prod kubeez.com auth, set this so Vite's
# HMR websocket connects back through the tunnel on wss:443.
# VITE_DEV_TUNNEL_HOST=dev-editor.kubeez.com
